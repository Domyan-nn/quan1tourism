# Backend: set these in your shell before starting the API.
# Defaults use .runtime/quan1.db and .runtime/media for local development.
DATABASE_URL=sqlite:///.runtime/quan1.db
MEDIA_ROOT=.runtime/media
COOKIE_SECURE=false
# PostgreSQL/PostGIS alternative (replace placeholders in your environment):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<database>
# No translation/TTS credentials required for manual editing and audio upload.
