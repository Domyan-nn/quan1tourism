# Set variables in the shell, or create .runtime/local.env (gitignored).
# PostgreSQL local setup: python scripts/setup_postgresql.py --import-sqlite
DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5432/quan1tourism
# Without DATABASE_URL, SQLite remains available at .runtime/quan1.db.
# MEDIA_ROOT defaults to the absolute project .runtime/media directory.
COOKIE_SECURE=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Wikipedia/Wikidata/Commons imports and local Ollama need no cloud API key.
