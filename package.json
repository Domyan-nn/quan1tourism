{
  "name": "quan1-stories",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/security-audit.mjs patch",
    "test:security": "node --test tests/security-audit.test.mjs",
    "audit:security": "npm run test:security && node scripts/security-audit.mjs audit",
    "start:local": "node scripts/dev.mjs",
    "dev": "npm run dev --workspace @quan1/admin",
    "dev:web": "npm run dev --workspace @quan1/web",
    "mobile:lan": "npm run start --workspace @quan1/mobile",
    "mobile:tunnel": "npm run tunnel --workspace @quan1/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @quan1/mobile",
    "test:mobile": "node --experimental-strip-types --test tests/mobile-logic.test.mjs",
    "test:tooling": "node --test tests/expo-tooling.test.mjs",
    "test:qr": "node --experimental-strip-types --test tests/expo-link.test.mjs",
    "test:qr:ui": "playwright test --config playwright.qr.config.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:site": "node scripts/build-site.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "typecheck": "tsc --noEmit -p apps/admin && tsc --noEmit -p apps/web && npm run typecheck:edge && npm run typecheck:mobile",
    "typecheck:edge": "tsc --noEmit -p tsconfig.edge.json",
    "test:edge": "node --test tests/cloudflare-map-tiles.test.mjs tests/cloudflare-proxy.test.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir .runtime/worker-bundle",
    "test:e2e": "playwright test",
    "test:narration": "node --experimental-strip-types --test tests/narration-logic.test.mjs",
    "test:categories": "node --experimental-strip-types --test tests/category-label.test.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7",
    "@expo/ngrok": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
