# Set variables in the shell, or create .runtime/local.env (gitignored).
# PostgreSQL local setup: python scripts/setup_postgresql.py --import-sqlite
DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5432/quan1tourism
# Supabase: copy the Session Pooler URI (port 5432) from Connect in the dashboard,
# then add ?sslmode=require. postgres:// and postgresql:// are accepted.
# SQLite is permitted only outside production; production fails if PostgreSQL is missing.
# MEDIA_ROOT defaults to the absolute project .runtime/media directory.
MEDIA_STORAGE_DRIVER=local
# Render: MEDIA_STORAGE_DRIVER=supabase. Keep this bucket private.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=place-images
# Backend only: use a secret API key (preferred), or legacy service_role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COOKIE_SECURE=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
APP_ENV=development
# Render uses APP_ENV=production, COOKIE_SECURE=true, AI_MODE=worker.
# The PC may keep AI_MODE=direct when running the entire app locally.
AI_MODE=direct
AI_TRANSLATION_ENABLED=true
# Pilot only. Batch >1 additionally requires an explicitly reviewed locale list.
AI_TRANSLATION_BATCH_LIMIT=1
AI_TRANSLATION_PENDING_LIMIT=3
AI_TRANSLATION_VERIFIED_LOCALES=
AI_GENERATION_TIMEOUT_SECONDS=120
AI_SERVER_URL=https://quan1-tourism-api.onrender.com
# Same random secret (>=32 characters) on the PC and in Render, never in VITE_*.
AI_WORKER_TOKEN=
# Wikipedia/Wikidata/Commons imports and local Ollama need no cloud API key.
# Admin map search, compatible with the Photon API; can point to a private instance.
GEOCODING_URL=https://photon.komoot.io/api/
# Website build-time QR settings. Copy the actual URL printed by Expo CLI.
# Empty/disabled by default. Change then restart Vite or rebuild the website.
# Online builds: set these in the actual builder (GitHub repository Actions
# variables or Cloudflare Workers Builds build variables), not runtime bindings.
VITE_EXPO_QR_ENABLED=false
VITE_EXPO_GO_URL=
# Mobile public origin; Expo reads apps/mobile/.env (see that directory's example).
# Never add backend/worker/database secrets to EXPO_PUBLIC_*.
EXPO_PUBLIC_API_ORIGIN=https://quan1-tourism-api.onrender.com
